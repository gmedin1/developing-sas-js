<!-- Footer -->
<footer id="footer" class="footer">
  <div class="footer__container">
    <div class="footer__wrapper">
      <iframe
        class="footer__map"
        width="450"
        height="250"
        frameborder="0"
        style="border: 0"
        src="{{map}}"
        allowfullscreen
      >
      </iframe>
    </div>
    <div class="footer__wrapper">
      <h3 class="footer__title">{{title}}</h3>
      <p class="footer__text">{{text}}</p>
    </div>
    <div class="footer__wrapper">
      <div class="footer__visit">Visitanos</div>
      <ol class="footer__address">
        {{#each address}}
          <li>{{this}}</li>
        {{/each}}
      </ol>
    </div>
    <div class="footer__wrapper">
      <div class="footer__contact">Contactanos vía Mail</div>
      <ol class="footer__list">
        {{#each emails}}
          <li>{{this}}</li>
        {{/each}}
      </ol>
      <div class="footer__contact">Números de Contacto</div>
      <ol class="footer__list">
        {{#each phones}}
          <li>{{this}}</li>
        {{/each}}
      </ol>
    </div>
  </div>
  <p class="footer__copyright">{{copyright}} &copy;</p>
</footer>
