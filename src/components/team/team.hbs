<!-- Team -->
<section id="team" class="team">
  <h3 class="team__title">{{title}} <span>{{highlight}}</span></h3>
  <div class="team__container">
    {{#each members}}
      <article class="member member-{{inc @index}}">
        <div class="member__info">
          <p class="member__name">{{name}}</p>
          <p class="member__title">{{role}}</p>
        </div>
      </article>
    {{/each}}
  </div>
</section>
