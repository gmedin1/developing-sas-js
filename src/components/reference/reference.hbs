<!-- Referencias -->
<section id="reference" class="reference">
  <article class="reference__card">
    <div class="reference__left">
      <h4 class="reference__title">{{card.title}}</h4>
      <p class="reference__reference">{{card.text}}</p>
    </div>
    <div class="reference__right">
      <img src="{{img card.image.src}}" alt="{{card.image.alt}}" class="reference__img" />
    </div>
  </article>
  <article class="info">
    <div class="info__right">
      <h3 class="info__title">{{info.title}}</h3>
      <div class="underline"></div>
    </div>
    <div class="info__left">
      <p class="info__text">{{info.text}}</p>
    </div>
  </article>
</section>
